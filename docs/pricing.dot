digraph Classes {
 graph [bgcolor="transparent", rankdir=LR, nodesep=0.28, ranksep=0.45, compound=true];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#7794aa", fontname="DejaVu Sans", fontsize=11];
 edge [color="#45637a", arrowsize=0.65];
 subgraph cluster_price {
 label="Pricing"; color="#8ca5ba";
 PricingService -> PriceComponent;
 BasePrice -> PriceComponent [style=dashed,arrowhead=empty];
 InsurancePrice -> PriceComponent [style=dashed,arrowhead=empty];
 DeliveryPrice -> PriceComponent [style=dashed,arrowhead=empty];
 BasePrice -> PricingStrategy;
 InsurancePrice -> PriceComponent [label=" wraps", fontsize=9];
 DeliveryPrice -> PriceComponent [label=" wraps", fontsize=9];
 HourlyPricing -> PricingStrategy [style=dashed,arrowhead=empty];
 DailyPricing -> PricingStrategy [style=dashed,arrowhead=empty];
 }
 }
