digraph Classes {
 graph [bgcolor="transparent", rankdir=LR, nodesep=0.28, ranksep=0.45, compound=true];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#7794aa", fontname="DejaVu Sans", fontsize=11];
 edge [color="#45637a", arrowsize=0.65];
 subgraph cluster_catalog {
 label="Catalog"; color="#8ca5ba";
 RentalFacade -> VehicleCatalog;
 VehicleFactory -> Vehicle [style=dashed];
 CarFactory -> VehicleFactory [arrowhead=empty];
 BikeFactory -> VehicleFactory [arrowhead=empty];
 VanFactory -> VehicleFactory [arrowhead=empty];
 VehicleCatalog -> Vehicle;
